<section id="transactions-list" class="panel" aria-labelledby="transactions-list-heading">
  <h2 id="transactions-list-heading">{{ list.text.listHeading }}</h2>
  {% if list.empty %}<p class="empty-state">{{ list.text.empty }}</p>{% else %}<div class="table-wrap"><table>
    <thead><tr><th>{{ list.text.date }}</th><th>{{ list.text.description }}</th><th>{{ list.text.category }}</th><th>{{ list.text.amount }}</th><th>{{ list.text.status }}</th><th>{{ list.text.fixedCost }}</th><th>{{ list.text.internalTransferFilter }}</th><th>{{ list.text.actions }}</th></tr></thead>
    <tbody>{% for row in list.rows %}<tr><td>{{ row.date }}</td><td>{{ row.description }}</td><td>{{ row.category }}</td><td>{{ row.amount }}</td><td>{{ row.status }}</td><td>{{ row.fixedCostLabel }}</td><td>{% if row.internalTransfer %}<span>{{ row.internalTransferLabel }}</span>{% endif %}</td><td class="actions-cell"><a class="action-link" href="{{ row.editUrl }}" aria-label="{{ list.text.edit }}" title="{{ list.text.edit }}">{{ list.text.edit }}</a><form class="inline-form" method="post" action="{{ row.internalTransferUrl }}" hx-post="{{ row.internalTransferUrl }}" hx-target="#transactions-list" hx-swap="outerHTML"><input type="hidden" name="internalTransfer" value="{{ row.internalTransferValue }}"><button class="link-button" type="submit" aria-label="{{ row.internalTransferAction }}" title="{{ row.internalTransferAction }}">{{ row.internalTransferAction }}</button></form><form class="inline-form" method="post" action="{{ row.deleteUrl }}" hx-post="{{ row.deleteUrl }}" hx-target="#transactions-list" hx-swap="outerHTML"><button class="link-button" type="submit" aria-label="{{ list.text.delete }}" title="{{ list.text.delete }}">{{ list.text.delete }}</button></form></td></tr>{% endfor %}</tbody>
  </table></div>{% endif %}
</section>
