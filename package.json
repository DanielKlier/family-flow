{
  "name": "family-flow",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "dev": "node --env-file=.env --watch --import tsx src/app/server.ts",
    "dev:oidc": "node --env-file=.env.dev --watch --import tsx src/app/server.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/adapters/http/assets && cp src/adapters/http/assets/app.css dist/adapters/http/assets/app.css && mkdir -p dist/views && cp -R src/views/. dist/views/",
    "docker:build": "docker compose --env-file .env.example build",
    "start": "node dist/app/server.js",
    "db:migrate": "tsx src/adapters/db/migrate.ts",
    "arch:check": "tsx scripts/check-architecture.ts && tsx scripts/check-template-architecture.ts",
    "requirements:check": "tsx scripts/check-requirement-traceability.ts",
    "evidence:check": "tsx scripts/check-test-evidence.ts",
    "test": "vitest run",
    "test:postgres": "tsx scripts/run-postgres-tests.ts",
    "test:e2e": "playwright test",
    "ops:verify": "env -u NODE_OPTIONS tsx scripts/verify-operation.ts",
    "verify": "pnpm format:check && pnpm lint && pnpm test && pnpm evidence:check && pnpm test:e2e && pnpm build",
    "lint": "biome lint . && pnpm arch:check && pnpm requirements:check",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@fastify/view": "^12.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.11.3",
    "htmx.org": "^2.0.10",
    "nunjucks": "^3.2.4",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.54.2",
    "@types/node": "^26.2.0",
    "@types/nunjucks": "^3.2.6",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  }
}
